name: ETH Daily Bot

on:
  schedule:
    - cron: '30 3 * * *'
  workflow_dispatch:

jobs:
  trade:
    runs-on: ubuntu-latest
    permissions:
      contents: write
    steps:
      - uses: actions/checkout@v4
      - uses: actions/setup-python@v5
        with:
          python-version: '3.11'
      - run: pip install requests
      - run: python bot.py
      - run: |
          git config --global user.name "bot"
          git config --global user.email "bot@bot.com"
          git add eth_paper.csv || true
          git commit -m "Auto log update" || true
          git push || true
